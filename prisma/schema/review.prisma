model Review {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  mealId String
  meal   Meal   @relation(fields: [mealId], references: [id])

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, mealId])
  @@index([mealId])
  @@map("reviews")
}